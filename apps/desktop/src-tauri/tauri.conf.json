{
    "$schema": "https://schema.tauri.app/config/2",
    "productName": "Resolvr",
    "version": "0.2.7",
    "identifier": "com.hojttaler.resolvr",
    "build": {
        "beforeDevCommand": "pnpm vite",
        "devUrl": "http://localhost:5273",
        "beforeBuildCommand": "pnpm vite:build",
        "frontendDist": "../dist"
    },
    "app": {
        "windows": [
            {
                "label": "main",
                "title": "Resolvr",
                "width": 1280,
                "height": 820,
                "minWidth": 900,
                "minHeight": 600,
                "resizable": true,
                "fullscreen": false,
                "acceptFirstMouse": true,
                "dragDropEnabled": true,
                "visible": false,
                "transparent": false
            }
        ],
        "security": {
            "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' ipc: http://ipc.localhost ws: wss: http: https:"
        }
    },
    "plugins": {
        "fs": {
            "requireLiteralLeadingDot": false
        },
        "deep-link": {
            "desktop": {
                "schemes": [
                    "resolvr"
                ]
            }
        },
        "updater": {
            "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEIyRTE2NzVEODVDOTBDODAKUldTQURNbUZYV2Zoc3ZvLy9va1p6ajZNay95a3FQZStUR01sZDZJcnM0Rm5PdkZVOHUvSlFJRysK",
            "endpoints": [
                "https://github.com/hojttaler/Resolvr/releases/latest/download/latest.json"
            ]
        }
    },
    "bundle": {
        "active": true,
        "targets": "all",
        "icon": [
            "icons/32x32.png",
            "icons/128x128.png",
            "icons/128x128@2x.png",
            "icons/icon.icns",
            "icons/icon.ico"
        ],
        "category": "DeveloperTool",
        "copyright": "© hojttaler",
        "shortDescription": "Desktop GraphQL client and IDE",
        "longDescription": "Resolvr is a desktop GraphQL client: tabs and drafts that survive crashes, collections in git-friendly files, environments that refresh tokens, flows as smoke tests, a schema browser and a built-in MCP server for AI agents.",
        "homepage": "https://github.com/hojttaler/Resolvr",
        "macOS": {
            "minimumSystemVersion": "13.0"
        },
        "resources": {
            "../../../packages/mcp-server/dist/index.js": "mcp/index.js",
            "resources/mcp-package.json": "mcp/package.json"
        },
        "createUpdaterArtifacts": true
    }
}
