{
    "$schema": "https://schema.tauri.app/config/2",
    "productName": "Resolvr",
    "version": "0.1.0",
    "identifier": "com.hojttaler.resolvr",
    "build": {
        "beforeDevCommand": "pnpm vite",
        "devUrl": "http://localhost:5273",
        "beforeBuildCommand": "pnpm vite:build",
        "frontendDist": "../dist"
    },
    "app": {
        "macOSPrivateApi": true,
        "windows": [
            {
                "label": "main",
                "title": "Resolvr",
                "width": 1280,
                "height": 820,
                "minWidth": 900,
                "minHeight": 600,
                "resizable": true,
                "fullscreen": false,
                "transparent": true,
                "titleBarStyle": "Overlay",
                "hiddenTitle": true,
                "acceptFirstMouse": true,
                "dragDropEnabled": true,
                "visible": false
            }
        ],
        "security": {
            "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' ipc: http://ipc.localhost ws: wss: http: https:"
        }
    },
    "plugins": {
        "fs": {
            "requireLiteralLeadingDot": false
        },
        "deep-link": {
            "desktop": {
                "schemes": [
                    "resolvr"
                ]
            }
        }
    },
    "bundle": {
        "active": true,
        "targets": [
            "app",
            "dmg"
        ],
        "icon": [
            "icons/icon.icns"
        ],
        "category": "DeveloperTool",
        "copyright": "© hojttaler",
        "shortDescription": "GraphQL-клиент с сохранением состояния",
        "macOS": {
            "minimumSystemVersion": "13.0"
        },
        "resources": {
            "../../../packages/mcp-server/dist/index.js": "mcp/index.js"
        }
    }
}
