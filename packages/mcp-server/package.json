{
    "name": "@resolvr/mcp",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "bin": {
        "resolvr-mcp": "./dist/index.js"
    },
    "scripts": {
        "build": "esbuild src/index.ts --bundle --platform=node --target=node20 --format=esm --outfile=dist/index.js --banner:js=\"import{createRequire}from'node:module';const require=createRequire(import.meta.url);\"",
        "start": "node dist/index.js",
        "dev": "tsx src/index.ts",
        "typecheck": "tsc --noEmit",
        "test:e2e": "node scripts/e2e-check.mjs"
    },
    "dependencies": {
        "@resolvr/core": "workspace:*",
        "@modelcontextprotocol/sdk": "^1.30.0",
        "graphql": "^17.0.2",
        "zod": "^4.4.3"
    },
    "devDependencies": {
        "@types/node": "^26.2.0",
        "esbuild": "^0.28.2",
        "tsx": "^4.23.12",
        "typescript": "^5.9.3"
    }
}
