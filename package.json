{
    "name": "resolvr",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "packageManager": "pnpm@10.33.0",
    "engines": {
        "node": ">=20.15.0"
    },
    "scripts": {
        "dev": "pnpm --filter @resolvr/desktop dev",
        "build": "pnpm -r build",
        "typecheck": "pnpm -r typecheck",
        "test": "pnpm -r test",
        "lint": "eslint .",
        "format": "prettier --write .",
        "mock": "pnpm --filter @resolvr/mock-server start",
        "install:app": "bash scripts/install-app.sh",
        "release": "bash scripts/release.sh"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@rolldown/binding-darwin-arm64": "^1.2.4",
        "@types/node": "^26.2.0",
        "eslint": "^10.8.1",
        "playwright": "^1.63.0",
        "prettier": "^3.9.6",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.67.0",
        "vitest": "^4.1.10"
    }
}
